{
  "name": "multi-agent-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "build:app": "mygo build -skip-installer",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "verify": "npm run build:web && go vet ./... && go test ./... && npm run test:e2e",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "mygo-runtime": "^0.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mygo-cli": "^0.9.0",
    "playwright": "^1.65.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
