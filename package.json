{
  "name": "multi-agent-desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "cli": "go run . -headless",
    "dev:signed": "mygo dev -sign 'multi-agent-desktop dev'",
    "build": "mygo build",
    "build:app": "mygo build -skip-installer",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "npm run typecheck && vite build",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "verify": "npm run typecheck && go vet ./... && go test -race ./... && npm run test:e2e",
    "test:go:e2e": "go test -tags e2e ./...",
    "test:e2e": "playwright test",
    "dev:llama": "${LLAMA_CPP_DIR:-$HOME/Documents/gowork/llama.cpp}/build/bin/llama-server -m ${LLAMA_MODEL:-$HOME/Documents/gowork/llama.cpp/models/qwen2.5-0.5b-instruct-q4_k_m.gguf} --host 127.0.0.1 --port 8080 -c 4096"
  },
  "dependencies": {
    "@tiptap/core": "^3.35.0",
    "@tiptap/extension-mention": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "@tiptap/suggestion": "^3.35.0",
    "cmdk": "^1.1.1",
    "mygo-runtime": "^0.9.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-textarea-autosize": "^8.5.9",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "mygo-cli": "^0.9.0",
    "playwright": "^1.65.0",
    "typescript": "^7",
    "vite": "^8"
  }
}
