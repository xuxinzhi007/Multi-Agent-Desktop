        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\npackage agent\n\nimport (\n\t\"context\"\n\t\"encoding/json\"\n\t\"strings\"\n\n\t\"multi-agent-desktop/internal/tool\"\n)\n\n// askAgentTool 让当前会话在进程里问另一个会话，并等它的文字回复。\ntype askAgentTool struct {\n\tm      *Manager\n\tfromID string\n}\n\nfunc (*askAgentTool) Name() string { return \"ask_agent\" }\n\nfunc (*askAgentTool) Description() string {\n\treturn \"Ask another agent in this app by its session name and wait for the reply. \" +\n\t\t\"Use it to delegate a subtask. Pass name and task. Do not ask yourself.\"\n}\n\nfunc (*askAgentTool) Writes() bool { return false }\n\nfunc (*askAgentTool) Schema() json.RawMessage {\n\treturn json.RawMessage(`{\n\t\t\"type\": \"object\",\n\t\t\"properties\": {\n\t\t\t\"name\": {\"type\": \"string\"},\n\t\t\t\"task\": {\"type\": \"string\"}\n\t\t},\n\t\t\"required\": [\"name\", \"task\"],\n\t\t\"additionalProperties\": false\n\t}`)\n}\n\nfunc (t *askAgentTool) Execute(ctx context.Context, raw json.RawMessage) tool.Result {\n\tvar in struct {\n\t\tName string `json:\"name\"`\n\t\tTask string `json:\"task\"`\n\t}\n\tif err := json.Unmarshal(raw, \u0026in); err != nil {\n\t\treturn tool.Fail(\"cannot parse arguments: %v\", err)\n\t}\n\tin.Name = strings.TrimSpace(in.Name)\n\tin.Task = strings.TrimSpace(in.Task)\n\tif in.Name == \"\" || in.Task == \"\" {\n\t\treturn tool.Fail(\"name and task are required\")\n\t}\n\ttarget, err := t.m.FindByName(in.Name)\n\tif err != nil {\n\t\treturn tool.Fail(\"%v\", err)\n\t}\n\tif target.ID == t.fromID {\n\t\treturn tool.Fail(\"不能问自己\")\n\t}\n\tif err := t.m.beginAsk(t.fromID, target.ID); err != nil {\n\t\treturn tool.Fail(\"%v\", err)\n\t}\n\tdefer t.m.endAsk(t.fromID)\n\n\tdone := make(chan struct{})\n\tif err := t.m.Prompt(ctx, PromptRequest{AgentID: target.ID, Text: in.Task, Done: done}); err != nil {\n\t\treturn tool.Fail(\"无法把任务交给 %s：%v\", in.Name, err)\n\t}\n\tselect {\n\tcase \u003c-ctx.Done():\n\t\treturn tool.Fail(\"等待 %s 回复时被取消或超时\", in.Name)\n\tcase \u003c-done:\n\t}\n\treply := lastAssistantText(target)\n\tif reply == \"\" {\n\t\treturn tool.Fail(\"%s 没有给出文字回复\", in.Name)\n\t}\n\treturn tool.OK(in.Name + \"：\\n\" + reply)\n}\n\nfunc lastAssistantText(a *Agent) string {\n\tsn := a.Snapshot()\n\tfor i := len(sn.Messages) - 1; i \u003e= 0; i-- {\n\t\tif sn.Messages[i].Role == \"assistant\" \u0026\u0026 strings.TrimSpace(sn.Messages[i].Content) != \"\" {\n\t\t\treturn sn.Messages[i].Content\n\t\t}\n\t}\n\treturn \"\"\n}\n\n\u003c/tool_output\u003e",
