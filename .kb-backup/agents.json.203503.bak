        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\npackage channel\n\nimport (\n\t\"encoding/json\"\n\t\"fmt\"\n\t\"os\"\n\t\"strings\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Message 是频道里的一条消息。\ntype Message struct {\n\tID        string `json:\"id\"`\n\tChannelID string `json:\"channelId\"`\n\tFromID    string `json:\"fromId\"` // agent ID 或 \"user\"\n\tFromName  string `json:\"fromName\"`\n\tText      string `json:\"text\"`\n\tAt        int64  `json:\"at\"`\n\tKind      string `json:\"kind,omitempty\"` // user / agent / system\n\n\t// Deliveries 记录投递结果：谁收到了、谁跳过了\n\tDeliveries []Delivery `json:\"deliveries,omitempty\"`\n}\n\n// Delivery 是消息的投递记录。\ntype Delivery struct {\n\tAgentID string `json:\"agentId\"`\n\tStatus  string `json:\"status\"`           // delivered / skipped / failed\n\tReason  string `json:\"reason,omitempty\"` // 跳过原因\n}\n\n// TurnPolicy 回合策略。\ntype TurnPolicy string\n\nconst (\n\t// PolicyDirect 只有被点名的人回（单聊）\n\tPolicyDirect TurnPolicy = \"direct\"\n\t// PolicyDiscuss 所有成员都能看到上下文，按 @ 或显式指派决定谁回\n\tPolicyDiscuss TurnPolicy = \"discuss\"\n\t// PolicyRoundRobin 轮流发言，用于评审场景\n\tPolicyRoundRobin TurnPolicy = \"roundrobin\"\n)\n\n// Channel 是一个共享消息频道。\ntype Channel struct {\n\tID       string     `json:\"id\"`\n\tName     string     `json:\"name\"`\n\tMembers  []string   `json:\"members\"` // agent IDs\n\tMessages []Message  `json:\"messages\"`\n\tPolicy   TurnPolicy `json:\"policy,omitempty\"` // 回合策略，默认 discuss\n}\n\n// Manager 管理所有频道。\ntype Manager struct {\n\tmu       sync.RWMutex\n\tchannels map[string]*Channel\n\torder    []string\n\tstore    string // 持久化文件路径，空则不持久化\n\n\t// saveMu 串行化落盘：Create/AddMessage/RemoveMember 都会 go m.Save()。\n\tsaveMu sync.Mutex\n\t// saveWG 跟踪异步 Save，测试可用 waitSaves 等待落盘结束。\n\tsaveWG sync.WaitGroup\n}\n\nfunc NewManager() *Manager {\n\treturn \u0026Manager{\n\t\tchannels: make(map[string]*Channel),\n\t}\n}\n\n// SetStore 设置持久化文件路径，并尝试加载。\nfunc (m *Manager) SetStore(path string) error {\n\tm.mu.Lock()\n\tm.store = path\n\tm.mu.Unlock()\n\treturn m.Load()\n}\n\n=== Message struct ===\n13:type Message struct {\n14-\tID        string `json:\"id\"`\n15-\tChannelID string `json:\"channelId\"`\n16-\tFromID    string `json:\"fromId\"` // agent ID 或 \"user\"\n17-\tFromName  string `json:\"fromName\"`\n18-\tText      string `json:\"text\"`\n19-\tAt        int64  `json:\"at\"`\n20-\tKind      string `json:\"kind,omitempty\"` // user / agent / system\n21-\n22-\t// Deliveries 记录投递结果：谁收到了、谁跳过了\n23-\tDeliveries []Delivery `json:\"deliveries,omitempty\"`\n24-}\n25-\n26-// Delivery 是消息的投递记录。\n27-type Delivery struct {\n28-\tAgentID string `json:\"agentId\"`\n29-\tStatus  string `json:\"status\"`           // delivered / skipped / failed\n30-\tReason  string `json:\"reason,omitempty\"` // 跳过原因\n31-}\n32-\n33-// TurnPolicy 回合策略。\n\n\u003c/tool_output\u003e",
