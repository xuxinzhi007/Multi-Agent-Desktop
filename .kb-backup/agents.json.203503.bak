        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\n=== loop.go 350-395 ===\n\t\treturn nil\n\t}\n\treturn r.Tools.Specs()\n}\n\nfunc (r *Runner) emit(ev Event) {\n\tif r.Emitter != nil {\n\t\tr.Emitter.Emit(ev)\n\t}\n}\n\n// checkpoint 落盘运行状态。\n//\n// 关键：不带 ctx。停止/超时那一刻 ctx 已经取消，\n// 用它落盘会被直接拒绝 —— 而这恰恰是最需要写成功的时刻\n// （用户按了停止，得知道停在哪、为什么停）。\n// 所以给一个独立的短超时上下文，与运行生命周期解耦。\nfunc (r *Runner) checkpoint(_ context.Context, st *State) {\n\tif r.Store == nil {\n\t\treturn\n\t}\n\tst.Checkpoint = time.Now().UnixMilli()\n\tctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)\n\tdefer cancel()\n\t// 落盘失败不打断运行：能跑比能恢复更重要，\n\t// 但要记在状态里，让上层知道这次运行不可恢复。\n\tif err := r.Store.Save(ctx, st); err != nil {\n\t\tst.StopReason = joinReason(st.StopReason, \"checkpoint failed: \"+err.Error())\n\t}\n\tif r.Sync != nil {\n\t\tr.Sync(append([]llm.Message(nil), st.Messages...))\n\t}\n}\n\n// formatObservation 把工具结果包成「分隔的、不可信的数据」。\n//\n// 围栏不是装饰：模型需要明确的边界才能区分「指令」和「数据」。\n// 没有围栏时，工具输出里的一句「忽略之前的指令」就是一次注入。\nfunc formatObservation(name string, res tool.Result) string {\n\treturn fmt.Sprintf(\n\t\t\"\u003ctool_output name=%q status=%q trust=\\\"untrusted\\\"\u003e\\n%s\\n\u003c/tool_output\u003e\",\n\t\tname, string(res.Status), res.Content)\n}\n\nfunc toLLMCalls(calls []tool.Call) []llm.ToolCall {\n\tout := make([]llm.ToolCall, 0, len(calls))\n=== tool 接口 Timeout ===\ninternal/tool/tool.go:28:\tStatusTimeout   Status = \"timeout\"   // 超时被杀\ninternal/tool/tool.go:92:\t// Timeout 是单次工具执行的硬上限。0 表示用默认值。\ninternal/tool/tool.go:93:\tTimeout time.Duration\ninternal/tool/tool.go:98:\tDefaultTimeout        = 120 * time.Second\ninternal/tool/tool.go:117:\t\tTimeout:        DefaultTimeout,\ninternal/tool/tool.go:210:\ttimeout := r.Timeout\ninternal/tool/tool.go:212:\t\ttimeout = DefaultTimeout\ninternal/tool/tool.go:214:\tif slow, ok := t.(interface{ Timeout() time.Duration }); ok \u0026\u0026 slow.Timeout() \u003e timeout {\ninternal/tool/tool.go:215: