        "role": "tool",
        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\n\treturn true\n}\n\n// Route 从一个 agent 发消息给另一个 agent（agent 主动协作）。\nfunc (m *Manager) Route(fromId, toId, text string) error {\n\tfrom, ok := m.Get(fromId)\n\tif !ok {\n\t\treturn fmt.Errorf(\"agent %s not found\", fromId)\n\t}\n\n\t// 记录 from 的消息（作为上下文）\n\tfrom.mu.Lock()\n\tfrom.Messages = append(from.Messages, llm.Message{\n\t\tRole:    \"user\",\n\t\tContent: fmt.Sprintf(\"[to %s] %s\", toId, text),\n\t})\n\tfrom.mu.Unlock()\n\n\t// 触发 to 的执行\n\treturn m.Prompt(context.Background(), PromptRequest{\n\t\tAgentID: toId,\n\t\tText:    fmt.Sprintf(\"[from %s] %s\", fromId, text),\n\t})\n}\n\n// workerLoop 每个 agent 一个，循环消费队列。\n//\n// 每次 execute 都必须有 recover。\n// 没有的话，任何一处 panic（比如 CLI 输出格式变化导致的无检查类型断言）\n// 都会让这个 goroutine 直接死掉：queue 还在收消息，但再没人消费，\n// 界面上表现为「发出去一直排队，永远不动」——\n// 而且没有任何错误提示，因为 panic 发生在后台，用户看不到。\n//\n// 宁可让这一条消息失败并报错，也不能让 worker 消失。\nfunc (a *Agent) workerLoop(m *Manager) {\n\tfor {\n\t\tselect {\n\t\tcase \u003c-a.done:\n\t\t\treturn\n\t\tcase req := \u003c-a.queue:\n\t\t\ta.runSafely(m, req)\n=== RouteAgent ===\n\treturn s.mgr.Unblock(id)\n}\n\n// RouteAgent 从一个 agent 发消息给另一个 agent（agent 主动协作）。\nfunc (s *API) RouteAgent(fromId, toId, text string) error {\n\treturn s.mgr.Route(fromId, toId, text)\n}\n\n// CreateChannel 新建频道。policy 为空时由 channel 包回落 discuss。\nfunc (s *API) CreateChannel(name string, members []string, policy string) channel.Channel {\n\tch := s.channels.Create(\"\", name, members, channel.TurnPolicy(policy))\n\tChannelCreated.Emit(s.win, ch)\n\treturn ch\n}\n\n// ListChannels 返回所有频道快照。\nfunc (s *API) ListChannels() []channel.Channel {\n\treturn s.channels.List()\n}\n\n// SendToChannel 发消息到频道，并触发相关成员 agent。\n\n\u003c/tool_output\u003e",
        "toolId": "call_01_ejj3yODD4Pl8Z1CrfJAm5105",
        "timestamp": 1794913849
      },
