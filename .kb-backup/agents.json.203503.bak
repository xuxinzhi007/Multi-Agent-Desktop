        "content": "\u003ctool_output name=\"read_file\" status=\"ok\" trust=\"untrusted\"\u003e\n   331\t\tif !found {\n   332\t\t\treturn fmt.Errorf(\"message %s not found\", msgID)\n   333\t\t}\n   334\t\tm.goSave()\n   335\t\treturn nil\n   336\t}\n   337\t\n   338\t// Broadcast 发消息到频道，返回创建的消息副本与所有成员 agent ID。\n   339\t// 消息总会被记录，即使用户是唯一发送者；接收者排除发送者自身。\n   340\tfunc (m *Manager) Broadcast(channelId, fromId, fromName, text string) (Message, []string, error) {\n   341\t\tmsg, err := m.AddMessage(channelId, fromId, fromName, text)\n   342\t\tif err != nil {\n   343\t\t\treturn Message{}, nil, err\n   344\t\t}\n   345\t\n   346\t\tm.mu.RLock()\n   347\t\tch := m.channels[channelId]\n   348\t\tvar recipients []string\n   349\t\tif ch != nil {\n   350\t\t\tfor _, memberId := range ch.Members {\n   351\t\t\t\tif memberId != fromId {\n   352\t\t\t\t\trecipients = append(recipients, memberId)\n   353\t\t\t\t}\n   354\t\t\t}\n   355\t\t}\n   356\t\tm.mu.RUnlock()\n   357\t\n   358\t\treturn msg, recipients, nil\n   359\t}\n   360\t\n   361\t// Transcript 是频道的共享上下文，按预算裁剪后拼入 prompt。\n   362\ttype Transcript struct {\n   363\t\tMessages []Message\n   364\t\tBudget   int // 字符预算\n   365\t}\n   366\t\n   367\t// BuildTranscript 从频道消息构建 transcript，按预算裁剪。\n   368\t// 保留最近的消息，确保预算内。\n   369\tfunc BuildTranscript(messages []Message, budget int) Transcript {\n   370\t\tif budget \u003c= 0 || len(messages) == 0 {\n   371\t\t\treturn Transcript{Messages: messages, Budget: budget}\n   372\t\t}\n   373\t\n   374\t\t// 从后往前累积，直到超预算\n   375\t\tvar out []Message\n   376\t\tused := 0\n   377\t\tfor i := len(messages) - 1; i \u003e= 0; i-- {\n   378\t\t\tm := messages[i]\n   379\t\t\tsize := len(m.FromName) + len(m.Text) + 20\n   380\t\t\tif used+size \u003e budget \u0026\u0026 len(out) \u003e 0 {\n   381\t\t\t\tbreak\n   382\t\t\t}\n   383\t\t\tout = append([]Message{m}, out...)\n   384\t\t\tused += size\n   385\t\t}\n   386\t\treturn Transcript{Messages: out, Budget: budget}\n   387\t}\n   388\t\n   389\t// Render 把 transcript 渲染成 prompt 段。\n   390\tfunc (t Transcript) Render() string {\n   391\t\tif len(t.Messages) == 0 {\n   392\t\t\treturn \"\"\n   393\t\t}\n   394\t\tvar b strings.Builder\n   395\t\tb.WriteString(\"## 群聊上下文\\n\")\n   396\t\tfor _, m := range t.Messages {\n   397\t\t\tb.WriteString(m.FromName)\n   398\t\t\tb.WriteString(\": \")\n   399\t\t\tb.WriteString(m.Text)\n   400\t\t\tb.WriteString(\"\\n\")\n   401\t\t}\n   402\t\treturn b.String()\n   403\t}\n   404\t\n   405\t// ShouldReply 判断 agent 是否应该回复这条消息。\n   406\t// 按 TurnPolicy 和 @提及决定；role 供 discuss 模式判定相关性（空则不判）。\n   407\tfunc ShouldReply(policy TurnPolicy, msg Message, agentID, agentName, role string) (bool, string) {\n   408\t\t// 解析 @提及\n   409\t\tmentions := ParseMentions(msg.Text)\n   410\t\n   411\t\t// 被 @ 必须回复（含 @all）\n   412\t\tfor _, m := range mentions {\n   413\t\t\tif m == agentName || m == agentID || m == \"all\" {\n   414\t\t\t\treturn true, \"被 @\"\n   415\t\t\t}\n   416\t\t}\n   417\t\n   418\t\t// 有 @ 但没 @ 到我 —— 让被点名的人说，不打扰其他成员\n   419\t\tif len(mentions) \u003e 0 {\n   420\t\t\treturn false, \"有 @ 但未点到我\"\n   421\t\t}\n   422\t\n   423\t\t// 按策略判断\n   424\t\tswitch policy {\n   425\t\tcase PolicyDirect:\n   426\t\t\t// 单聊：成员就该回，不靠 @ 触发（之前这里返回 false，导致 direct 频道永不回复）\n   427\t\t\treturn true, \"direct 模式 · 全员回复\"\n   428\t\n   429\t\tcase PolicyDiscuss:\n   430\t\t\t// 讨论模式：没被 @ 时由 DecideReplies 统一选 1 个最相关的成员，\n   431\t\t\t// 这里返回 false，避免 N 成员 = N 倍成本。\n   432\t\t\treturn false, \"discuss 模式 · 未被点名\"\n   433\t\n   434\t\tcase PolicyRoundRobin:\n   435\t\t\treturn true, \"roundrobin 模式\"\n   436\t\n   437\t\tdefault:\n   438\t\t\treturn false, \"未识别的策略\"\n   439\t\t}\n   440\t}\n   441\t\n   442\t// RoleRelevant 判断消息是否与该角色相关（供 SendToChannel 排序用）。\n   443\t// 关键词表来自角色名（\"后端\" / \"前端\" / \"测试\" / \"运维\"）与内容的子串匹配。\n   444\tfunc RoleRelevant(text, role string) bool {\n   445\t\tif role == \"\" {\n   446\t\t\treturn false\n   447\t\t}\n   448\t\tkeywords := map[string][]string{\n   449\t\t\t\"后端\": {\"api\", \"api\", \"数据库\", \"sql\", \"服务\", \"接口\", \"server\", \"backend\"},\n   450\t\t\t\"前端\": {\"ui\", \"页面\", \"组件\", \"样式\", \"css\", \"前端\", \"react\", \"frontend\"},\n... (130 more lines)\n\n\u003c/tool_output\u003e",
