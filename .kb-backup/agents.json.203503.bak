        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\ninternal/llm/llm.go:16:type Message struct {\ninternal/llm/llm.go-17-\tRole      string     `json:\"role\"` // system | user | assistant | tool\ninternal/llm/llm.go-18-\tContent   string     `json:\"content\"`\ninternal/llm/llm.go-19-\tToolCalls []ToolCall `json:\"toolCalls,omitempty\"` // role=assistant 时模型发起的调用\ninternal/llm/llm.go-20-\tToolID    string     `json:\"toolId,omitempty\"`    // role=tool 时对应哪个调用\ninternal/llm/llm.go-21-\tTimestamp int64      `json:\"timestamp,omitempty\"` // Unix 秒\ninternal/llm/llm.go-22-\tReasoning string     `json:\"reasoning,omitempty\"` // 思考模式的推理，不并进 content\ninternal/llm/llm.go-23-}\ninternal/llm/llm.go-24-\ninternal/llm/llm.go-25-// ToolCall 是模型请求的一次工具调用。\ninternal/llm/llm.go-26-type ToolCall struct {\ninternal/llm/llm.go-27-\tID    string          `json:\"id\"`\ninternal/llm/llm.go-28-\tName  string          `json:\"name\"`\ninternal/llm/llm.go-29-\tInput json.RawMessage `json:\"input\"`\ninternal/llm/llm.go-30-}\ninternal/llm/llm.go-31-\n=== llm.Message usage in snapshot for UI ===\n\treturn map[string]any{\n\t\t\"id\":            a.ID,\n\t\t\"name\":          a.Name,\n\t\t\"role\":          a.Role,\n\t\t\"color\":         a.Color,\n\t\t\"status\":        string(a.Status),\n\t\t\"createdAt\":     a.CreatedAt,\n\t\t\"messages\":      append([]llm.Message(nil), a.Messages...),\n\t\t\"queueLen\":      a.QueueLen,\n\t\t\"backend\":       a.Backend,\n\t\t\"workDir\":       a.WorkDir,\n\t\t\"llmCfg\":        a.LLMCfg, // nil 时前端收到 null，表示沿用全局默认\n\t\t\"knowledge\":     append([]string(nil), a.Knowledge...),\n\t\t\"blockedReason\": a.BlockedReason,\n\t}\n}\n\n\u003c/tool_output\u003e",
