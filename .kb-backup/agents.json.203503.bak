        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\n47:type PromptRequest = agent.PromptRequest\n48-\n49-// ShellResult 是命令执行结果。\n50-type ShellResult = pty.Result\n51-\n52-// ShellRequest 是一次 shell 执行。\n53-type ShellRequest struct {\n54-\tAgentID string `json:\"agentId\"`\n55-\tCommand string `json:\"command\"`\n56-}\n57-\n58-// CreateAgentRequest 是新建 agent 的参数。\n59-type CreateAgentRequest struct {\n60-\tName string `json:\"name\"`\n61-\tRole string `json:\"role\"`\n62-}\n63-\n64-// Events 推给前端。\n65-var (\n66-\tAgentCreated = mygo.NewEvent[Agent](\"agent.created\")\n67-\tAgentDeleted = mygo.NewEvent[string](\"agent.deleted\")\n=== mgr.Prompt ===\ninternal/agent/manager.go:573:func (m *Manager) Prompt(ctx context.Context, req PromptRequest) error {\ninternal/agent/manager.go-574-\ta, ok := m.Get(req.AgentID)\ninternal/agent/manager.go-575-\tif !ok {\ninternal/agent/manager.go-576-\t\treturn fmt.Errorf(\"agent %s not found\", req.AgentID)\ninternal/agent/manager.go-577-\t}\ninternal/agent/manager.go-578-\ninternal/agent/manager.go-579-\tif err := a.enqueue(req); err != nil {\ninternal/agent/manager.go-580-\t\treturn fmt.Errorf(\"agent %s: %w\", req.AgentID, err)\ninternal/agent/manager.go-581-\t}\ninternal/agent/manager.go-582-\ta.mu.Lock()\ninternal/agent/manager.go-583-\tqueued := a.Status == StatusIdle\ninternal/agent/manager.go-584-\tif queued {\ninternal/agent/manager.go-585-\t\ta.Status = StatusQueued\ninternal/agent/manager.go-586-\t\t// 记下进入排队的时刻：界面靠它区分「刚排队」和「卡住了」。\ninternal/agent/manager.go-587-\t\t// 两者长得一样，但处置方式完全不同。\ninternal/agent/manager.go-588-\t\ta.QueuedAt = time.Now().Unix()\ninternal/agent/manager.go-589-\t}\ninternal/agent/manager.go-590-\ta.mu.Unlock()\ninternal/agent/manager.go-591-\t// emit 必须在解锁之后。\ninternal/agent/manager.go-592-\t//\ninternal/agent/manager.go-593-\t// 订阅者（main.go 的 emitToWindow、以及将来任何想知道\ninternal/agent/manager.go-594-\t// 「这个 agent 现在什么状态」的回调）会调 Get/Snapshot，\ninternal/agent/manager.go-595-\t// 那是要拿 a.mu 的。持锁调用就是自己锁自己：\ninternal/agent/manager.go-596-\t// 整个 agent 永久停在 queued，界面显示「排队中」但 worker 再也动不了。\ninternal/agent/manager.go-597-\tif queued {\ninternal/agent/manager.go-598-\t\tm.emit(\"agent.status\", map[string]any{\"id\": a.ID, \"status\": StatusQueued})\ninternal/agent/manager.go-599-\t}\ninternal/agent/manager.go-600-\treturn nil\ninternal/agent/manager.go-601-}\ninternal/agent/manager.go-602-\ninternal/agent/manager.go-603-// Stop 取消一个 agent 的当前执行并清空队列。\ninternal/agent/manager.go-604-func (m *Manager) Stop(id string) bool {\ninternal/agent/manager.go-605-\ta, ok := m.Get(id)\ninternal/agent/manager.go-606-\tif !ok {\ninternal/agent/manager.go-607-\t\treturn false\ninternal/agent/manager.go-608-\t}\ninternal/agent/manager.go-609-\ta.StopAll()\ninternal/agent/manager.go-610-\tm.emit(\"agent.status\", map[string]any{\"id\": id, \"status\": StatusIdle})\ninternal/agent/manager.go-611-\treturn true\ninternal/agent/manager.go-612-}\ninternal/agent/manager.go-613-\n\n\u003c/tool_output\u003e",
