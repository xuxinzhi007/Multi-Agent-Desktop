        "role": "tool",
        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\n=== tool.Tool 接口 ===\n// Package tool 提供受控的工具执行协议。\n//\n// 为什么不是简单的函数注册表：模型给出的调用是「不可信输入」。\n// 参数可能非法、工具可能篡改文件、命令可能挂死、输出可能超长、\n// 同一个调用可能被重复发起。每一种都要有明确的处理路径，\n// 否则这些异常会以 panic 或静默失败的形式漏到主循环里。\npackage tool\n\nimport (\n\t\"context\"\n\t\"crypto/sha256\"\n\t\"encoding/hex\"\n\t\"encoding/json\"\n\t\"errors\"\n\t\"fmt\"\n\t\"sync\"\n\t\"time\"\n)\n\n// Status 是工具调用的结局。必须让模型能区分这几种情况 ——\n// 只回一个字符串的话，它没法判断「该重试」还是「该换路」。\ntype Status string\n\nconst (\n\tStatusOK        Status = \"ok\"\n\tStatusError     Status = \"error\"     // 执行了但失败\n\tStatusDenied    Status = \"denied\"    // 用户拒绝\n\tStatusTimeout   Status = \"timeout\"   // 超时被杀\n\tStatusTruncated Status = \"truncated\" // 结果被截断\n)\n\n// Meta 是给 UI 和审计用的信息，不回填进模型上下文。\ntype Meta struct {\n\tDurationMS int  `json:\"durationMs\"`\n\tBytesRaw   int  `json:\"bytesRaw\"`\n\tBytesSent  int  `json:\"bytesSent\"`\n\tExitCode   int  `json:\"exitCode,omitempty\"`\n\tTruncated  bool `json:\"truncated\"`\n\tRepeated   bool `json:\"repeated,omitempty\"`\n}\n\n// Call 是模型发起的一次工具调用。\ntype Call struct {\n\tID    string          `json:\"id\"`\n\tName  string          `json:\"name\"`\n\tInput json.RawMessage `json:\"input\"`\n}\n\n// Result 是一次调用的结局。\ntype Result struct {\n\tCallID  string `json:\"callId\"`\n\tStatus  Status `json:\"status\"`\n\tContent string `json:\"content\"`\n\tMeta    Meta   `json:\"meta\"`\n}\n\n// OK 构造成功结果。\nfunc OK(content string) Result { return Result{Status: StatusOK, Content: content} }\n\n// Fail 构造失败结果。错误以结构化形式回给模型，不抛到主循环。\n=== 前端能调 route 吗 ===\nsrc/lib/useBackend.ts:359:        return API.routeAgent(\nsrc/mygo.ts:550:  /** RouteAgent 从一个 agent 发消息给另一个 agent（agent 主动协作）。 */\nsrc/mygo.ts:551:  routeAgent(fromId: string, toId: string, text: string): Promise\u003cvoid\u003e {\nsrc/mygo.ts:552:    return call(\"API.RouteAgent\", fromId, toId, text);\n\n\u003c/tool_output\u003e",
