        "content": "\u003ctool_output name=\"bash\" status=\"ok\" trust=\"untrusted\"\u003e\n\t\t\t\t\"message\":   view,\n\t\t\t\t\"tokensIn\":  0,\n\t\t\t\t\"tokensOut\": 0,\n\t\t\t})\n\t\t}\n\t\tif channelID != \"\" \u0026\u0026 out.FinalText != \"\" {\n\t\t\tm.emit(\"agent.channel.reply\", map[string]any{\n\t\t\t\t\"channelId\": channelID,\n\t\t\t\t\"agentId\":   a.ID,\n\t\t\t\t\"agentName\": a.Name,\n\t\t\t\t\"text\":      out.FinalText,\n\t\t\t})\n\t\t}\n\t\ta.setIdleOrQueued(m)\n\tcase loop.PhaseStopped:\n\t\tm.emit(\"agent.stopped\", map[string]any{\n\t\t\t\"id\":     a.ID,\n\t\t\t\"reason\": out.StopReason,\n\t\t\t\"iter\":   out.Iteration,\n\t\t\t\"used\":   out.Budget.UsedIterations,\n\t\t})\n\t\ta.noteStop(out.StopReason)\n\t\ta.setIdleOrQueued(m)\n\tcase loop.PhaseBudget:\n\t\tm.finish(a, StatusError, \"预算用尽：\"+out.StopReason)\n\tdefault:\n\t\tm.finish(a, StatusError, out.StopReason)\n\t}\n}\n\n// loopEmitter 把循环事件翻译成前端已有的事件语言。\n//\n// 不做成一对一映射：前端关心的是「现在在干什么」，\n// 而不是「循环内部第几步」。所以 iter.start 转成状态更新，\n// tool.start 转成 LastTool，tool.end 转成消息增量。\ntype loopEmitter struct {\n\tm     *Manager\n\tagent *Agent\n}\n\nfunc (e *loopEmitter) Emit(ev loop.Event) {\n\tswitch ev.Kind {\n\tcase \"iter.start\":\n\t\te.m.emit(\"agent.status\", map[string]any{\"id\": e.agent.ID, \"status\": StatusRunning})\n\tcase \"reasoning\":\n\t\te.m.emit(\"agent.reasoning\", map[string]any{\"id\": e.agent.ID, \"reasoning\": ev.Text})\n\tcase \"tool.start\":\n\t\tlabel := ev.Tool\n\t\tif ev.Text != \"\" {\n\t\t\tlabel = ev.Text\n\t\t}\n\t\te.agent.mu.Lock()\n\t\te.agent.LastTool = label\n\t\te.agent.mu.Unlock()\n\t\te.m.emit(\"agent.tool\", map[string]any{\n\t\t\t\"id\": e.agent.ID, \"tool\": ev.Tool, \"phase\": \"start\", \"content\": label,\n\t\t})\n\tcase \"tool.end\":\n\t\tif ev.Result != nil {\n\t\t\te.agent.mu.Lock()\n\t\t\te.agent.Chars += len(ev.Result.Content)\n\t\t\te.agent.mu.Unlock()\n\t\t}\n\t\te.m.emit(\"agent.tool\", map[string]any{\n\t\t\t\"id\": e.agent.ID, \"tool\": ev.Tool, \"phase\": \"end\",\n\t\t\t\"status\": string(ev.Status), \"content\": truncate(ev.Content, 400),\n\t\t})\n\tcase \"done\", \"stopped\", \"failed\":\n\t\te.m.emit(\"agent.loop\", map[string]any{\n\t\t\t\"id\": e.agent.ID, \"kind\": ev.Kind, \"iter\": ev.Iter, \"reason\": ev.Reason,\n\t\t})\n\t}\n}\n\nfunc truncate(s string, n int) string {\n\tif len(s) \u003c= n {\n\t\treturn s\n\t}\n\treturn s[:n] + \"…\"\n}\n\n=== PromptRequest ===\ninternal/agent/manager.go:529:type PromptRequest struct {\ninternal/agent/manager.go-530-\tAgentID string `json:\"agentId\"`\ninternal/agent/manager.go-531-\tText    string `json:\"text\"`\ninternal/agent/manager.go-532-\t// ChannelID 非空表示这条 prompt 来自群聊，回复要写回该频道。\ninternal/agent/manager.go-533-\t// 不再依赖从文本里猜 [channel:xxx] 标记。\ninternal/agent/manager.go-534-\tChannelID string `json:\"channelId,omitempty\"`\ninternal/agent/manager.go-535-\t// Done 在这条消息执行结束后关闭。ask_agent 用它等待对方回复。\ninternal/agent/manager.go-536-\tDone chan struct{} `json:\"-\"`\ninternal/agent/manager.go-537-\t// outcome 非空时，结束原因写在这里再关闭 Done。只关闭 Done 时，等待方分不清正常回复和异常退出。\ninternal/agent/manager.go-538-\toutcome *promptOutcome `json:\"-\"`\ninternal/agent/manager.go-539-}\ninternal/agent/manager.go-540-\ninternal/agent/manager.go-541-// promptOutcome 是主 agent 等子 agent 时拿到的那一次信号。\n\n\u003c/tool_output\u003e",
